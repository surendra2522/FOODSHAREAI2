{
  "name": "foodshare-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install --prefix frontend && npm install --prefix backend && npm install --prefix database",
    "dev-backend": "npm run dev --prefix backend",
    "dev-frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\"",
    "seed": "npm run seed --prefix database"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
